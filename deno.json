{
	"name": "@marianmeres/countries",
	"version": "1.0.0",
	"exports": {
		".": "./src/mod.ts",
		"./search": "./src/search.ts",
		"./timezones": "./src/timezones.ts",
		"./locales/sk": "./src/locales/sk.ts"
	},
	"tasks": {
		"gen": "deno run -A scripts/gen-data.ts",
		"test": "deno test --allow-read",
		"test:watch": "deno test --allow-read --watch",
		"npm:build": "deno run -A scripts/build-npm.ts",
		"npm:publish": "deno run -A scripts/build-npm.ts && cd ./.npm-dist && npm publish --access=public",
		"release": "deno run -A jsr:@marianmeres/deno-release",
		"publish": "deno publish && deno task npm:publish",
		"rp": "deno task release -y && deno task publish",
		"rpm": "deno task release minor -y && deno task publish"
	},
	"imports": {
		"@marianmeres/npmbuild": "jsr:@marianmeres/npmbuild@^1",
		"@marianmeres/searchable": "jsr:@marianmeres/searchable@^2.7.0",
		"@std/assert": "jsr:@std/assert@^1",
		"@std/fs": "jsr:@std/fs@^1",
		"@std/path": "jsr:@std/path@^1"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 90,
		"indentWidth": 4,
		"proseWrap": "preserve"
	},
	"publish": {
		"exclude": ["scripts", "tests", "tmp"]
	}
}
